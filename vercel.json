{
  "redirects": [
    { "source": "/produto/produto-ideia-ao-lucro", "destination": "/da-ideia-ao-lucro/", "permanent": true },
    { "source": "/publicacao/:slug.html", "destination": "/publicacao/:slug", "permanent": true },
    { "source": "/blog/:slug.html", "destination": "/blog/:slug", "permanent": true },
    { "source": "/produto/:slug.html", "destination": "/produto/:slug", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://globalinvest.onrender.com/api/:path*" },
