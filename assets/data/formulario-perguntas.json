        },
        {
          "title": "Marketing, integrações e LGPD",
          "fields": [
            { "key": "necessidade_seo", "label": "Há necessidade de otimização para buscadores (SEO)?", "type": "yesno" },
            { "key": "anuncios_google_ads", "label": "Há intenção de anunciar no Google Ads?", "type": "yesno" },
            { "key": "google_analytics", "label": "Será necessário instalar o Google Analytics?", "type": "yesno" },
            { "key": "google_tag_manager", "label": "Será necessário o Google Tag Manager?", "type": "yesno" },
            { "key": "meta_pixel", "label": "Será necessário o Meta Pixel (Facebook/Instagram Ads)?", "type": "yesno" },
            { "key": "sistemas_externos", "label": "Existem sistemas externos que deverão ser integrados?", "type": "textarea" },
            { "key": "exigencias_lgpd", "label": "Há exigências específicas relacionadas à LGPD para este projeto?", "type": "textarea" }
