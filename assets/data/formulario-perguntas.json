            { "key": "meios_pagamento", "label": "Quais meios de pagamento?", "type": "checkbox", "options": ["PIX", "Cartão", "Boleto", "Outros"], "showIf": { "key": "aceitar_pagamentos", "equals": "Sim" } },
            { "key": "agendamento_online", "label": "Precisará de agendamento online?", "type": "yesno" },
            { "key": "multilingue", "label": "O site será multilíngue?", "type": "yesno" },
            { "key": "idiomas", "label": "Quais idiomas?", "type": "text", "showIf": { "key": "multilingue", "equals": "Sim" } }
