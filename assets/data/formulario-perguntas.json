            { "key": "form_contato", "label": "Precisará de formulário de contato?", "type": "yesno" },
            { "key": "integracao_whatsapp", "label": "Precisará de integração com WhatsApp?", "type": "yesno" },
            { "key": "integracao_redes_sociais", "label": "Precisará integrar redes sociais?", "type": "yesno" },
